# Never place a real key in this example file.
OPENAI_API_KEY=
# Higher quality options: gpt-5.6-terra (balanced) or gpt-5.6 (routes to Sol).
OPENAI_MODEL=gpt-5.4-mini

# Korean public food nutrition API (server-only)
PUBLIC_FOOD_API_ENABLED=false
PUBLIC_FOOD_API_KEY=
# Optional override when the public API endpoint version changes.
PUBLIC_FOOD_API_BASE_URL=https://apis.data.go.kr/1471000/FoodNtrCpntDbInfo02/getFoodNtrCpntDbInq02
